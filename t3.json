{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "assets/dev/blueprint-ios-1024.png",
  "scripts": [
    {
      "name": "Setup Worktree",
      "command": "vp i && ln -sf $T3CODE_PROJECT_ROOT/.env .env",
      "icon": "configure",
      "runOnWorktreeCreate": true
    },
    {
      "name": "Setup Worktree (Windows)",
      "command": "vp i && New-Item -ItemType SymbolicLink -Path .env -Target \"$env:T3CODE_PROJECT_ROOT\\.env\" -Force",
      "icon": "configure",
      "runOnWorktreeCreate": true
    }
  ]
}
