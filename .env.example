# Optional: T3 Connect source builds
# `cp .env.example .env` enables T3 Connect against the production deployment.
# These are the same public identifiers baked into official release builds, not
# secrets. Remove or comment them out to build with cloud features disabled.
# Do not add server-side secrets to this file.

# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys and JWT templates.
T3CODE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
T3CODE_CLERK_JWT_TEMPLATE=t3-relay

# Production relay.
T3CODE_RELAY_URL=https://relay.t3.codes

# Public, ingest-only mobile OpenTelemetry configuration.
# T3CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# T3CODE_MOBILE_OTLP_TRACES_DATASET=t3-code-mobile-traces-dev
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...

# Release signing for the nightly channel. Without these, release builds use
# the Android debug keystore and cannot update a build signed elsewhere.
# T3CODE_ANDROID_KEYSTORE_PATH=/absolute/path/to/nightly.keystore
# T3CODE_ANDROID_KEYSTORE_PASSWORD=...
# T3CODE_ANDROID_KEY_ALIAS=nightly

# Firebase configuration for Android push notifications. Without it the app
# cannot mint an FCM token and no agent push is ever delivered; notifications
# for finished turns still fire locally while the app is running. CI reads the
# same file from the GOOGLE_SERVICES_JSON repository secret.
# T3CODE_ANDROID_GOOGLE_SERVICES_FILE=/absolute/path/to/google-services.json

# Build identity for the in-app nightly updater. CI sets the first two; a local
# build defaults to versionCode 1 and reads the commit from git. Android only
# installs an APK whose versionCode is at least the installed one, so bump this
# for every build you intend to install over another.
# T3CODE_ANDROID_VERSION_CODE=1
# T3CODE_BUILD_COMMIT=<40-char commit sha>
# Reference time for "is this release newer than what I am running". Defaults to
# the commit date of HEAD; it must stay stable for a given tree, because `extra`
# feeds the fingerprint runtimeVersion.
# T3CODE_BUILD_TIME=2026-01-01T00:00:00Z
# GitHub repository holding the `nightly` release the updater polls.
# T3CODE_UPDATE_REPOSITORY=Sowyu/t3pretzel
